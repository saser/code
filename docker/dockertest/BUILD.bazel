go_library(
    name = "dockertest",
    srcs = ["dockertest.go"],
    importpath = "go.saser.se/docker/dockertest",
    visibility = ["//visibility:public"],
    deps = [
        "//runfiles",
        "@com_github_ory_dockertest_v3//:dockertest",
        "@com_github_ory_dockertest_v3//docker",
    ],
)

