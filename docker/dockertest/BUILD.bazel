load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_load")

oci_load(
    name = "hello_world",
    image = "@hello_world",
    repo_tags = ["saser.se/docker/dockertest/hello_world:latest"],
)

filegroup(
    name = "hello_world.tar",
    srcs = [":hello_world"],
    output_group = "tarball",
)

