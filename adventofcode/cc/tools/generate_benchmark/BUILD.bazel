load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "generate_benchmark_lib",
    srcs = ["main.go"],
    embedsrcs = ["dayXX_benchmark.cc.template"],
    importpath = "go.saser.se/adventofcode/cc/tools/generate_benchmark",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "generate_benchmark",
    embed = [":generate_benchmark_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "generate_benchmark_test",
    srcs = ["main_test.go"],
    data = glob(["testdata/**"]) + [":generate_benchmark"],
    deps = ["//runfiles"],
)
